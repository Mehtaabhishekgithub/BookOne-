datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PROVIDER
  CLIENT
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
  REFUNDED
}

model User {
  id              String           @id @default(uuid())
  clerkId         String           @unique
  email           String           @unique
  firstName       String?
  lastName        String?
  role            Role             @default(CLIENT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  providerProfile ProviderProfile?
  bookings        Booking[]        @relation("ClientBookings")
}

model ProviderProfile {
  id           String         @id @default(uuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle       String         @unique // Public slug: e.g. "john-doe"
  headline     String?
  bio          String?        @db.Text
  timezone     String         @default("UTC")
  createdAt    DateTime       @default(now())

  services     Service[]
  availabilities Availability[]
  bookings     Booking[]      @relation("ProviderBookings")
}

model Service {
  id              String          @id @default(uuid())
  providerId      String
  provider        ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title           String
  description     String?         @db.Text
  durationMinutes Int             // e.g. 30, 45, 60
  price           Decimal         @db.Decimal(10, 2)
  currency        String          @default("USD")
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  bookings        Booking[]
}

model Availability {
  id              String          @id @default(uuid())
  providerId      String
  provider        ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek       Int             // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime       String          // "09:00" (stored in 24-hr format)
  endTime         String          // "17:00"
}

model Booking {
  id              String          @id @default(uuid())
  providerId      String
  provider        ProviderProfile @relation("ProviderBookings", fields: [providerId], references: [id])
  clientId        String?
  client          User?           @relation("ClientBookings", fields: [clientId], references: [id])
  clientName      String
  clientEmail     String
  serviceId       String
  service         Service         @relation(fields: [serviceId], references: [id])
  startTime       DateTime        // UTC ISO Timestamp
  endTime         DateTime        // UTC ISO Timestamp
  status          BookingStatus   @default(PENDING)
  stripeSessionId String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  invoice         Invoice?
}

model Invoice {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  invoiceNumber String        @unique // e.g. "INV-2026-0001"
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  status        InvoiceStatus @default(UNPAID)
  pdfUrl        String?
  createdAt     DateTime      @default(now())
}
