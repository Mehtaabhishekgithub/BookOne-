# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL via Prisma)
# Replace with your PostgreSQL connection URL (e.g. local PostgreSQL, Neon, Supabase)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/bookone_db?schema=public"

# Clerk Authentication (Phase 2)
CLERK_PUBLISHABLE_KEY="pk_test_placeholder"
CLERK_SECRET_KEY="sk_test_placeholder"
CLERK_WEBHOOK_SECRET="whsec_placeholder"

# Stripe Payments (Phase 4)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
STRIPE_SUCCESS_URL="http://localhost:5173/booking/success?session_id={CHECKOUT_SESSION_ID}"
STRIPE_CANCEL_URL="http://localhost:5173/booking/cancel"
